{
  "name": "decky-tools",
  "version": "0.1.0",
  "description": "SteamOS 游戏模式工具箱：Proton 运行时下载管理、系统监控等",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "tsc --noEmit && prettier --check .",
    "test:py": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "typescript": "^7.0.2"
  }
}
